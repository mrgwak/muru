#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>

#define ECHO_PIN D1
#define TRIG_PIN D2

const char* ssid = "NodeMCU_Ultrasonic";
const char* password = "12345678";

ESP8266WebServer server(80);

float getDistance() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);

  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  long duration = pulseIn(ECHO_PIN, HIGH, 30000);

  if (duration == 0) return -1;

  return duration * 0.0343 / 2.0;
}

void handleRoot() {
  String page = R"rawliteral(
  <!DOCTYPE html>
  <html>
  <head>
    <title>Ultrasonic Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
  </head>
  <body style="text-align:center;font-family:Arial">
    <h2>NodeMCU Ultrasonic Dashboard</h2>
    <h1 id="distance">-- cm</h1>
    <button onclick="downloadData()">Download CSV</button>

    <script>
      let records = ["Time,Distance (cm)"];

      function readSensor() {
        fetch('/data')
          .then(response => response.text())
          .then(value => {
            document.getElementById("distance").innerHTML =
              value + " cm";

            records.push(new Date().toLocaleTimeString() + "," + value);
          });
      }

      function downloadData() {
        let file = new Blob([records.join("\\n")],
                            {type: "text/csv"});
        let link = document.createElement("a");
        link.href = URL.createObjectURL(file);
        link.download = "sensor_data.csv";
        link.click();
      }

      setInterval(readSensor, 1000);
      readSensor();
    </script>
  </body>
  </html>
  )rawliteral";

  server.send(200, "text/html", page);
}

void handleData() {
  float distance = getDistance();

  if (distance < 0) {
    server.send(200, "text/plain", "0");
  } else {
    server.send(200, "text/plain", String(distance, 2));
  }
}

void setup() {
  Serial.begin(9600);

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);

  WiFi.mode(WIFI_AP);
  WiFi.softAP(ssid, password);

  Serial.println("Wi-Fi Hotspot Started");
  Serial.println(WiFi.softAPIP());

  server.on("/", handleRoot);
  server.on("/data", HTTP_GET, handleData);

  server.begin();
  Serial.println("HTTP Server Started");
}

void loop() {
  server.handleClient();
}
