#define SOUND_PIN D1
#define LED_PIN D2

void setup() {
  pinMode(SOUND_PIN, INPUT);
  pinMode(LED_PIN, OUTPUT);

  digitalWrite(LED_PIN, LOW);
  Serial.begin(9600);
}

void loop() {
  int soundState = digitalRead(SOUND_PIN);

  if (soundState == LOW) {
    digitalWrite(LED_PIN, HIGH);
    Serial.println("Sound High - LED ON");
  } else {
    digitalWrite(LED_PIN, LOW);
    Serial.println("Sound Low - LED OFF");
  }

  delay(200);
}
